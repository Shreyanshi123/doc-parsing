# ---------- General ----------
DATA_DIR=./data
LOG_LEVEL=INFO

# ---------- Where the pipeline may read local files from (comma separated) ----------
LOCAL_ALLOWED_ROOTS=./data/uploads,./samples

# ---------- Azure Blob (input) - needed only for blob URLs without a SAS token ----------
AZURE_STORAGE_CONNECTION_STRING=
# Optional: only allow downloads from these hosts (comma separated). Empty = allow any.
ALLOWED_URL_HOSTS=

# ---------- Output ----------
# local -> writes JSON to DATA_DIR/outputs ; azure -> uploads to AZURE_OUTPUT_CONTAINER
OUTPUT_BACKEND=local
AZURE_OUTPUT_CONTAINER=parsed-output

# ---------- OCR ----------
TESSERACT_CMD=
OCR_LANG=eng
OCR_DPI=200

# ---------- Vision LLM (free, local, via Ollama) ----------
OLLAMA_URL=http://localhost:11434
VLM_MODEL=qwen2.5vl:7b
VLM_MAX_PAGES=10
VLM_TIMEOUT_SEC=300

# ---------- Paid engine (optional, for later comparison) ----------
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# ---------- AWS Textract (optional; paid per processed page) ----------
# Install boto3 from requirements-extra.txt. Authenticate with an AWS profile,
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or the IAM role of the runtime.
AWS_REGION=
AWS_PROFILE=

# ---------- LlamaParse (cloud API - documents leave your network!) ----------
LLAMA_CLOUD_API_KEY=

# ---------- Background worker ----------
WORKER_THREADS=1
WORKER_POLL_SEC=1.0

# ---------- Figure reader for the smart_pdf parser (charts / diagrams -> text) ----------
# auto = Azure OpenAI if the three AZURE_OPENAI_* values below are filled, else local Ollama if it is running, else off
VISION_BACKEND=auto
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# max number of figures sent to the vision model per document (each one costs money / time)
MAX_FIGURES=8
